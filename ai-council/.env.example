# Copy to `.env` and fill in only the providers your seats use.
# Keys are read from the environment and never written into configs or minutes.
# `.env` is gitignored; `.env.example` is safe to commit.

# --- frontier labs ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=

# --- Chinese labs ---
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=          # Alibaba Qwen, DashScope compatible mode
MOONSHOT_API_KEY=           # Kimi
ZHIPU_API_KEY=              # GLM

# --- aggregators / fast inference ---
OPENROUTER_API_KEY=         # one key, most families; good for exploration
GROQ_API_KEY=
TOGETHER_API_KEY=

# --- local (no key needed) ---
# ollama serve        -> http://127.0.0.1:11434/v1
# vllm serve ...      -> http://127.0.0.1:8000/v1
# LM Studio           -> http://127.0.0.1:1234/v1

# Optional: fix the anonymisation/shuffle seed for reproducible runs.
# COUNCIL_SEED=20260101
