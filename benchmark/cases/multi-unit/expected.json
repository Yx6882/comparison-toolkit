{
  "name": "多方表决 · 单位混用（元 vs 千元）",
  "tool": "multi",
  "argv": [
    "multi",
    "{input}/报价A.csv",
    "{input}/报价B.csv",
    "{input}/报价C.csv",
    "--key",
    "物料号",
    "-o",
    "{out}"
  ],
  "report": "{out}/reconcile-multi.json",
  "must_find": [
    "M-1001|多数"
  ],
  "must_not_report": [
    "M-1001|无共识"
  ],
  "notes": "A 报 12000 元、B 报 12 千元，两者相等；C 报 13 千元（=13000 元）应判离群。如果不看「单位」列，12000 / 12 / 13 三个数各不相同，会被误判成无共识。"
}
