{
  "name": "进项税 · 红字冲销（编造但贴近真实）",
  "tool": "ledger",
  "argv": [
    "--voucher",
    "{input}/凭证明细.xlsx",
    "--invoice",
    "{input}/发票.xlsx",
    "--out",
    "{out}",
    "--json"
  ],
  "report": "{out}/vat-reconcile.json",
  "must_find": [
    "13%"
  ],
  "must_not_report": [
    "9%",
    "6%",
    "1%"
  ],
  "notes": "凭证 13% 是 1300，发票 13% 是 1300 + (-50 红字) = 1250，应报差 50。如果工具跳过负数发票，13% 就会被判成一致——那是漏报。"
}
