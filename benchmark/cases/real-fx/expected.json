{
  "name": "真实数据 · 人民币汇率 11-13 → 11-20",
  "tool": "reconcile",
  "argv": [
    "run",
    "{input}/2026-11-13.csv",
    "{input}/2026-11-20.csv",
    "--key",
    "货币",
    "--tolerance",
    "0.0001",
    "-o",
    "{out}"
  ],
  "report": "{out}/2026-11-13_vs_2026-11-20.json",
  "must_find": [
    "EUR",
    "JPY",
    "USD"
  ],
  "must_not_report": [],
  "notes": "汇率波动很小（0.09%–0.93%），默认 1% 容差会全部忽略，因此显式把容差调到 0.01%"
}
